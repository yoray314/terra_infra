location                      = "westeurope"
public_network_access_enabled = true

# Replace this documentation address with the workstation's public egress address.
allowed_ipv4_cidrs = [
  "203.0.113.10/32",
]

tags = {
  environment  = "learning"
  example      = "03-key-vault"
  "managed-by" = "opentofu"
  state         = "azure-blob"
}
